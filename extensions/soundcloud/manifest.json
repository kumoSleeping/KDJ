{
  "manifest_version": 3,
  "name": "KDJ SoundCloud",
  "version": "0.1.0",
  "description": "将当前浏览器的 SoundCloud 登录连接到本机 KDJ。",
  "permissions": ["cookies"],
  "host_permissions": ["https://soundcloud.com/*", "http://127.0.0.1/*"],
  "action": { "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  }
}
