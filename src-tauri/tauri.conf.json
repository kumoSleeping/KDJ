{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KDJ",
  "version": "0.2.36",
  "identifier": "com.kdj.app",
  "build": {
    "beforeDevCommand": "npm run tauri:web",
    "devUrl": "http://localhost:5274",
    "beforeBuildCommand": "npm run tauri:web:build",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "KDJ",
        "width": 1360,
        "height": 880,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#f2f2f2",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled",
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:5275 ws://localhost:5275; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kdj"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/kumoSleeping/KDJ/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQzIxN0ZBRDgyMzUzRjEKUldUeFV5UFkraGZDd0tCakZlcFpHcnZEMkRXQUlmN0lhNGw4cit4Z1JoQWRWcmE3RHRrUEQ3Q2sK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "DJ 曲库与多平台音乐/视频下载工作台",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.ios.plist"
    }
  }
}
