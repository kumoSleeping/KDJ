{
  "name": "kumodeck",
  "version": "0.2.0",
  "private": true,
  "description": "KumoDeck — DJ 曲库与多平台音乐/视频下载工作台",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sidecar:setup": "bash scripts/setup-sidecar.sh",
    "sidecar:test": "sidecar/.venv/bin/python -m pytest sidecar/tests -q",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "rust:server": "cargo run --release -p kumodeck-server --bin kumodeck-server",
    "rust:web": "vite --config vite.rust.config.ts",
    "rust:dev": "concurrently -n server,web -c cyan,magenta \"npm:rust:server\" \"npm:rust:web\"",
    "tauri": "tauri",
    "tauri:web": "vite --config vite.tauri.config.ts",
    "tauri:web:build": "tsc --noEmit && vite build --config vite.tauri.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "ws": "^8.21.1"
  }
}
