    "build": "npm run tauri:build",
    "preview": "vite preview --config vite.tauri.config.ts --outDir dist-tauri",
    "typecheck": "tsc --noEmit",
    "dist": "npm run tauri:build",
    "rust:server": "cargo run --release -p kdj-server --bin kdj-server",
    "rust:web": "vite --config vite.rust.config.ts",
    "rust:dev": "concurrently -n server,web -c cyan,magenta \"npm:rust:server\" \"npm:rust:web\"",
    "tauri": "tauri",
    "tauri:web": "vite --config vite.tauri.config.ts",
    "tauri:web:build": "tsc --noEmit && vite build --config vite.tauri.config.ts",
    "tauri:dev": "tauri dev --config src-tauri/tauri.labs.conf.json --features labs",
    "tauri:build": "tauri build",
    "test:dj-audio-policy": "esbuild src/lib/djAudioPolicy.test.ts --bundle --platform=node --format=esm --outfile=target/djAudioPolicy.test.mjs && node --test target/djAudioPolicy.test.mjs",
    "test:player-handoff": "esbuild tests/playerHandoffPolicy.test.ts --bundle --platform=node --format=esm --outfile=target/playerHandoffPolicy.test.mjs && node --test target/playerHandoffPolicy.test.mjs",
