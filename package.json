    "size:report": "bash scripts/report-bundle-size.sh",
    "test:download-retry-policy": "esbuild tests/downloadRetryPolicy.test.ts --bundle --platform=node --format=esm --outfile=target/downloadRetryPolicy.test.mjs && node --test target/downloadRetryPolicy.test.mjs"
