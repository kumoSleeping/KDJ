{
  "name": "kdj",
  "version": "0.2.39",
  "private": true,
  "description": "KDJ — DJ 曲库与多平台音乐/视频下载工作台",
  "scripts": {
    "dev": "npm run tauri:dev",
    "build": "npm run tauri:build",
    "preview": "vite preview --config vite.tauri.config.ts --outDir dist-tauri",
    "typecheck": "tsc --noEmit",
    "dist": "npm run tauri:build",
    "rust:server": "cargo run --release -p kdj-server --bin kdj-server",
    "rust:web": "vite --config vite.rust.config.ts",
    "rust:dev": "concurrently -n server,web -c cyan,magenta \"npm:rust:server\" \"npm:rust:web\"",
    "tauri": "tauri",
    "tauri:web": "vite --config vite.tauri.config.ts",
    "tauri:web:build": "tsc --noEmit && vite build --config vite.tauri.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:dj-audio-policy": "esbuild src/lib/djAudioPolicy.test.ts --bundle --platform=node --format=esm --outfile=target/djAudioPolicy.test.mjs && node --test target/djAudioPolicy.test.mjs",
    "test:player-handoff": "esbuild tests/playerHandoffPolicy.test.ts --bundle --platform=node --format=esm --outfile=target/playerHandoffPolicy.test.mjs && node --test target/playerHandoffPolicy.test.mjs",
    "test:latest-intent-gate": "esbuild tests/latestIntentGate.test.ts --bundle --platform=node --format=esm --outfile=target/latestIntentGate.test.mjs && node --test target/latestIntentGate.test.mjs",
    "test:waveform-render": "esbuild tests/waveformRenderPolicy.test.ts --bundle --platform=node --format=esm --outfile=target/waveformRenderPolicy.test.mjs && node --test target/waveformRenderPolicy.test.mjs",
    "test:lrc": "esbuild tests/lrc.test.ts --bundle --platform=node --format=esm --outfile=target/lrc.test.mjs && node --test target/lrc.test.mjs",
    "test:folder-expansion": "esbuild tests/folderExpansion.test.ts --bundle --platform=node --format=esm --outfile=target/folderExpansion.test.mjs && node --test target/folderExpansion.test.mjs",
    "test:video-float-box": "esbuild tests/videoFloatBox.test.ts --bundle --platform=node --format=esm --outfile=target/videoFloatBox.test.mjs && node --test target/videoFloatBox.test.mjs",
    "test:local-video-sync": "esbuild tests/localVideoSync.test.ts --bundle --platform=node --format=esm --outfile=target/localVideoSync.test.mjs && node --test target/localVideoSync.test.mjs",
    "test:local-video-seek-bridge": "esbuild tests/localVideoSeekBridge.test.ts --bundle --platform=node --format=esm --outfile=target/localVideoSeekBridge.test.mjs && node --test target/localVideoSeekBridge.test.mjs",
    "test:local-video-seek-timing": "esbuild tests/localVideoSeekTiming.test.ts --bundle --platform=node --format=esm --outfile=target/localVideoSeekTiming.test.mjs && node --test target/localVideoSeekTiming.test.mjs",
    "test:waveform-scrub": "esbuild tests/waveformScrub.test.ts --bundle --platform=node --format=esm --outfile=target/waveformScrub.test.mjs && node --test target/waveformScrub.test.mjs",
    "test:stream-analysis": "esbuild tests/streamAnalysis.test.ts --bundle --platform=node --format=esm --outfile=target/streamAnalysis.test.mjs && node --test target/streamAnalysis.test.mjs",
    "test:storage-write": "esbuild tests/storageWrite.test.ts --bundle --platform=node --format=esm --outfile=target/storageWrite.test.mjs && node --test target/storageWrite.test.mjs",
    "test:workspace-panes": "esbuild tests/workspacePanes.test.ts --bundle --platform=node --format=esm --outfile=target/workspacePanes.test.mjs && node --test target/workspacePanes.test.mjs",
    "test:frontend-logic": "npm run test:dj-audio-policy && npm run test:latest-intent-gate && npm run test:player-handoff && npm run test:waveform-render && npm run test:lrc && npm run test:waveform-scrub && npm run test:stream-analysis && npm run test:storage-write && npm run test:workspace-panes && npm run test:onelibrary-downloads && npm run test:onelibrary-interactions && npm run test:onelibrary-playback && npm run test:folder-expansion && npm run test:video-float-box && npm run test:local-video-sync && npm run test:local-video-seek-bridge && npm run test:local-video-seek-timing",
    "test:onelibrary-downloads": "esbuild tests/oneLibraryDownloads.test.ts --bundle --platform=node --format=esm --outfile=target/oneLibraryDownloads.test.mjs && node --test target/oneLibraryDownloads.test.mjs",
    "test:onelibrary-interactions": "esbuild tests/oneLibraryInteractions.test.ts --bundle --platform=node --format=esm --packages=external --define:import.meta.env.DEV=false --outfile=target/oneLibraryInteractions.test.mjs && node --test target/oneLibraryInteractions.test.mjs",
    "test:onelibrary-playback": "esbuild tests/oneLibraryPlayback.test.ts --bundle --platform=node --format=esm --define:import.meta.env.DEV=false --outfile=target/oneLibraryPlayback.test.mjs && node --test target/oneLibraryPlayback.test.mjs",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tauri-plugin-native-audio-api": "file:plugins/native-audio/guest-js",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "ws": "^8.21.1"
  }
}
