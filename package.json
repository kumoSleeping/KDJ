    "test:frontend-logic": "npm run test:dj-audio-policy && npm run test:latest-intent-gate && npm run test:tempo-command-lane && npm run test:loop-toggle-lane && npm run test:player-handoff && npm run test:deck-track-binding && npm run test:waveform-render && npm run test:waveform-binary && npm run test:waveform-palette && npm run test:lrc && npm run test:waveform-scrub && npm run test:waveform-viewport && npm run test:performance-cues && npm run test:eq-graph && npm run test:playback-prefs && npm run test:beat-grid-sync && npm run test:mixxx-mapping && npm run test:midi-mapping && npm run test:midi-library-nav && npm run test:midi-jog && npm run test:midi-soft-takeover && npm run test:stem-eq && npm run test:stem-deck-log && npm run test:stem-mode && npm run test:stream-analysis && npm run test:song-preview && npm run test:storage-write && npm run test:virtual-disk && npm run test:key-display && npm run test:table-sort && npm run test:workspace-panes && npm run test:track-drag && npm run test:work-mode && npm run test:onelibrary-downloads && npm run test:onelibrary-interactions && npm run test:onelibrary-playback && npm run test:folder-expansion && npm run test:video-float-box && npm run test:local-video-sync && npm run test:local-video-seek-bridge && npm run test:local-video-seek-timing && npm run test:bilibili-favorites && npm run test:youtube-player && npm run test:download-retry-policy",
