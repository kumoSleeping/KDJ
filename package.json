    "tauri:web:labs": "vite --mode labs --config vite.tauri.config.ts",
    "tauri:web:build:labs": "tsc --noEmit && vite build --mode labs --config vite.tauri.config.ts",
    "tauri:dev:stable": "tauri dev",
    "tauri:build:labs": "tauri build --config src-tauri/tauri.labs.conf.json --features labs",
    "build:labs": "npm run tauri:build:labs",
