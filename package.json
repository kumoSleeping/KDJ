    "test:performance-cues": "esbuild tests/performanceCues.test.ts --bundle --platform=node --format=esm --outfile=target/performanceCues.test.mjs && node --test target/performanceCues.test.mjs",
    "test:eq-graph": "esbuild tests/eqGraph.test.ts --bundle --platform=node --format=esm --outfile=target/eqGraph.test.mjs && node --test target/eqGraph.test.mjs",
