{
  "name": "kdj",
  "version": "1.0.0-rc4",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "KDJ — 本地曲库与多平台音乐/视频工作台",
  "scripts": {
    "dev": "npm run tauri:dev",
    "build": "npm run tauri:build",
    "preview": "vite preview --config vite.tauri.config.ts --outDir dist-tauri",
    "typecheck": "tsc --noEmit",
    "test:library": "node --import tsx --test tests/libraryWindow.test.ts tests/coverThumbnailQueue.test.ts tests/scrollThumb.test.ts && node scripts/test-library-ui.mjs",
    "dist": "npm run tauri:build",
    "rust:server": "cargo run --release -p kdj-server --bin kdj-server",
    "rust:web": "vite --config vite.rust.config.ts",
    "rust:dev": "concurrently -n server,web -c cyan,magenta \"npm:rust:server\" \"npm:rust:web\"",
    "tauri": "tauri",
    "tauri:web": "vite --config vite.tauri.config.ts",
    "tauri:web:build": "tsc --noEmit && vite build --config vite.tauri.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:ytm-media-session": "cargo test -p kdj-server protected_media::tests --lib && cargo test -p kdj-providers completed_protected_spool --lib",
    "probe:ytm-sabr": "tsx scripts/ytm-sabr-probe.ts",
    "release": "bash scripts/release.sh",
    "size:report": "bash scripts/report-bundle-size.sh",
    "size:frontend:check": "node scripts/check-frontend-bundle-size.mjs",
    "test:workshop": "node --import tsx --test tests/workshop.test.ts && node --conditions=import scripts/test-workshop-ui.mjs && node scripts/test-workshop-audition.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "bgutils-js": "4.0.3",
    "googlevideo": "^4.1.1",
    "lucide-react": "^0.468.0",
    "meriyah": "^6.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tauri-plugin-native-audio-api": "file:plugins/native-audio/guest-js",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "ws": "^8.21.1"
  }
}
