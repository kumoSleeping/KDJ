    "test:onelibrary-interactions": "esbuild tests/oneLibraryInteractions.test.ts --bundle --platform=node --format=esm --packages=external --define:import.meta.env.DEV=false --outfile=target/oneLibraryInteractions.test.mjs && node --test target/oneLibraryInteractions.test.mjs",
    "test:onelibrary-playback": "esbuild tests/oneLibraryPlayback.test.ts --bundle --platform=node --format=esm --define:import.meta.env.DEV=false --outfile=target/oneLibraryPlayback.test.mjs && node --test target/oneLibraryPlayback.test.mjs",
